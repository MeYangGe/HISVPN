#include "Generated.xcconfig"

// Statically link the Go core (built into libclash/ios/arm64/libclash.a).
// force_load keeps every cgo export that nothing else references; the host
// callbacks live in core/bride.c and the Swift bridge resolves them with
// dlsym(RTLD_DEFAULT, ...).
CORE_OTHER_LDFLAGS = -force_load $(PROJECT_DIR)/../libclash/ios/arm64/libclash.a -lresolv -framework Foundation -framework CoreFoundation -framework Security -framework SystemConfiguration -framework CFNetwork
OTHER_LDFLAGS = $(inherited) $(CORE_OTHER_LDFLAGS)
